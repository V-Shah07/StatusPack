# Copy to .env and fill in. Never commit .env.

# --- Datadog (REQUIRED for Phases 1-5) ---
# API + Application keys from https://app.datadoghq.com/organization-settings/api-keys
# and .../application-keys. The Application key needs synthetics_read/write scopes.
DD_API_KEY=your_datadog_api_key_here
DD_APP_KEY=your_datadog_app_key_here
# Datadog site: datadoghq.com (US1), us3./us5.datadoghq.com, datadoghq.eu, ap1.datadoghq.com
DD_SITE=datadoghq.com

# --- LLM (Phase 4+) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Alerting (Phase 2+) ---
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# --- App ---
# Public base URL of this FastAPI app, used when registering the Datadog
# monitor webhook that calls back into /webhook/datadog (Phase 2).
STATUSPACK_PUBLIC_URL=http://localhost:8000
STATUSPACK_DB_PATH=statuspack.db
